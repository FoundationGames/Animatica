{
  "schemaVersion": 1,
  "id": "animatica",
  "version": "${version}",

  "name": "Animatica Refabricated",
  "description": "Allow for animating more game textures using the MCPatcher/OptiFine animation format",
  "authors": [
    "FoundationGames, coredex-source"
  ],
  "contact": {
    "homepage": "https://github.com/coredex-source/AnimaticaRefabricated",
    "sources": "https://github.com/coredex-source/AnimaticaRefabricated",
    "issues": "https://github.com/coredex-source/AnimaticaRefabricated/issues",
  },

  "license": "LGPLv3",
  "icon": "assets/animatica/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.foundationgames.animatica.Animatica"
    ]
  },
  "mixins": [
    "animatica.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.11.3",
    "minecraft": ">=26.1",
    "java": ">=25"
  }
}
